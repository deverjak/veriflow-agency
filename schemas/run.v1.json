{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriflow.dev/schemas/run.v1.json",
  "title": "run.v1",
  "description": "Záznam jednoho běhu packu. Leží v .agency/runs/<run-id>/run.json a commituje se.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pack",
    "project",
    "target",
    "trigger",
    "startedAt",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ULID běhu; zároveň jméno adresáře.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "pack": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "description": "owner/repo"
        },
        "defaultBranch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "description": "Co se recenzovalo. Klíč (repo, pr, headRefOid) zajišťuje idempotenci — tentýž commit dvakrát nevyrobí duplikát.",
      "additionalProperties": false,
      "required": [
        "kind",
        "headRefOid"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pull-request",
            "merged-pull-request",
            "commit-range",
            "workspace"
          ],
          "description": "merged-pull-request je retrospektivní audit — bez něj nemá pack co dělat na projektu s jediným mergnutým PR. workspace je běh bez pull requestu: projekt tak, jak je právě teď, včetně rozdělané práce — na tom stojí QA, které zkouší běžící aplikaci."
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "headRefOid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseRefOid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "mergedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "filesReviewed": {
          "type": "integer",
          "minimum": 0
        },
        "filesSkipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Lockfily, generované soubory, snapshoty — šum pro graf i pro dimenze."
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Větev cíle u workspace běhu. U PR běhu se neplní."
        },
        "dirty": {
          "type": "boolean",
          "description": "Byla v pracovní kopii při startu nezacommitovaná změna? Nález z takového běhu může ukazovat na kód, který nikde jinde neexistuje."
        }
      }
    },
    "trigger": {
      "type": "object",
      "description": "Typ triggeru určuje typ credentialu. Attended → subscription, unattended → API klíč s rozpočtem. Musí to být v datech, ne ve slibu.",
      "additionalProperties": false,
      "required": [
        "kind",
        "attended"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "watch",
            "post-merge",
            "scheduled"
          ]
        },
        "attended": {
          "type": "boolean"
        },
        "heartbeatAgeSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Stáří heartbeatu živé session při startu. Když je moc staré, běh se zařadí a neproběhne."
        }
      }
    },
    "graph": {
      "type": "object",
      "description": "Stav code-review-graph při běhu. Bez toho se zpětně nepozná, jestli nález stál na čerstvém, nebo měsíc starém indexu.",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "enum": [
            "build",
            "update",
            "reused",
            "missing"
          ]
        },
        "nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edges": {
          "type": [
            "integer",
            "null"
          ]
        },
        "riskScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "changedFunctions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "untestedFunctions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "changedFiles": {
          "type": [
            "integer",
            "null"
          ]
        },
        "affectedFlows": {
          "type": [
            "integer",
            "null"
          ]
        },
        "updateError": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "description": "Bez tohohle nejde zodpovědět, jestli je systém výhodný i při plné API ceně — a to je jedno z kill criteria. Musí vzniknout dřív, než se nasbírá historie, do které se to zpětně nedoplní.",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential": {
          "enum": [
            "subscription",
            "api-key"
          ],
          "description": "Musí odpovídat trigger.attended — viz pravidlo výše."
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dimensions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wallClockSeconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "ok",
        "no-findings",
        "needs-login",
        "quota",
        "abandoned",
        "failed",
        "queued"
      ],
      "description": "abandoned is not failed: preparation succeeded and the agent was launched, then the terminal was closed before it finished. Nothing here can see that terminal, so the run stays open until a person closes it - which makes an abandoned run a fact worth recording rather than an error to hide."
    },
    "exitReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "integer",
          "minimum": 0,
          "description": "co vrátily dimenze"
        },
        "gated": {
          "type": "integer",
          "minimum": 0,
          "description": "zahozeno deterministickou bránou (bez evidence nebo bez file:line)"
        },
        "belowScore": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "kept": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "agent": {
      "type": "object",
      "description": "What handled the run. The model is part of the record because precision is compared between models, not only between packs. `hire` names the roster entry that took it — with several specialists over one pack, provider and model alone no longer identify who did the work.",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "examples": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = výchozí model providera"
        },
        "bin": {
          "type": "string"
        },
        "hire": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of the roster entry from .agency/hires.json, e.g. review-graph@codex. null = the run was handed over straight from the pack configuration."
        }
      }
    },
    "brief": {
      "type": "object",
      "description": "Zadání běhu. Dvě vrstvy, protože každá platí jinak dlouho: standing je konfigurace projektu a platí pořád, focus je tenhle jeden běh. Zapisuje se do run recordu proto, že „které zadání vyrábí lepší nálezy“ je otázka, kterou má nástroj umět zodpovědět čísly.",
      "additionalProperties": false,
      "properties": {
        "standing": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "prompt | scenario:<name> | scenario:<name>+prompt | config"
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Deterministický signál nasbíraný před během u packu, který nejede nad grafem — kolik souborů se změnilo, kolik commitů přibylo, kolik nálezů projekt už zná.",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "null"
        ]
      }
    },
    "gatedBy": {
      "type": [
        "object",
        "null"
      ],
      "description": "Kolik nálezů zahodila brána a proč — schema, phantom-file, phantom-line, below-score. Píše to ingest; bez rozpadu po důvodech se nedá poznat, čím pack nejčastěji plýtvá.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ],
      "description": "POSIX path of the throwaway worktree the run holds while it is running. It is recorded so a parallel run by another specialist can tell an occupied directory from an abandoned one instead of force-deleting a review in progress."
    }
  }
}
