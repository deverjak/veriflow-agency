{
  "name": "agency-spike",
  "displayName": "Agency — CommentController spike",
  "description": "Zjišťovací spike: unese VS Code Comments API nálezy zakotvené na jiný commit než working tree?",
  "version": "0.0.1",
  "publisher": "veriflow",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agency",
          "title": "Agency",
          "icon": "resources/agency.svg"
        }
      ]
    },
    "views": {
      "agency": [
        {
          "id": "agency.findings.view",
          "name": "Nálezy"
        }
      ]
    },
    "submenus": [
      {
        "id": "agency.rejectMenu",
        "label": "Zamítnout",
        "icon": "$(circle-slash)"
      }
    ],
    "commands": [
      {
        "command": "agency.review.pick",
        "title": "Zrecenzovat pull request…",
        "category": "Agency",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "agency.spike.run",
        "title": "Spustit všechny kontroly",
        "category": "Agency",
        "icon": "$(play)"
      },
      {
        "command": "agency.spike.showThreads",
        "title": "Vytvořit vlákna nálezů",
        "category": "Agency",
        "icon": "$(refresh)"
      },
      {
        "command": "agency.spike.reveal",
        "title": "Otevřít nález",
        "category": "Agency"
      },
      {
        "command": "agency.decision.apply",
        "title": "Zapsat rozhodnutí (programaticky)",
        "category": "Agency"
      },
      {
        "command": "agency.spike.clear",
        "title": "Zahodit vlákna",
        "category": "Agency"
      },
      {
        "command": "agency.finding.accept",
        "title": "Přijmout",
        "icon": "$(check)"
      },
      {
        "command": "agency.finding.defer",
        "title": "Odložit na později",
        "icon": "$(bookmark)"
      },
      {
        "command": "agency.finding.reject.not-reproducible",
        "title": "Nešlo zopakovat"
      },
      {
        "command": "agency.finding.reject.by-design",
        "title": "Chová se tak záměrně"
      },
      {
        "command": "agency.finding.reject.wrong-diagnosis",
        "title": "Špatná diagnóza — problém je jinde"
      },
      {
        "command": "agency.finding.reject.duplicate-missed",
        "title": "Duplicita, kterou dedup nechytil"
      },
      {
        "command": "agency.finding.reject.out-of-scope",
        "title": "Mimo rozsah projektu"
      },
      {
        "command": "agency.finding.rejectPick",
        "title": "Zamítnout (vybrat důvod ze seznamu)"
      },
      {
        "command": "agency.finding.addNote",
        "title": "Uložit poznámku"
      },
      {
        "command": "agency.finding.openAtCommit",
        "title": "Ukázat kód v den analýzy (read-only z commitu)",
        "icon": "$(history)"
      },
      {
        "command": "agency.finding.diffAgainstHead",
        "title": "Porovnat s pracovní kopií",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agency.finding.accept",
          "when": "false"
        },
        {
          "command": "agency.finding.defer",
          "when": "false"
        },
        {
          "command": "agency.finding.rejectPick",
          "when": "false"
        },
        {
          "command": "agency.finding.addNote",
          "when": "false"
        },
        {
          "command": "agency.finding.reject.not-reproducible",
          "when": "false"
        },
        {
          "command": "agency.finding.reject.by-design",
          "when": "false"
        },
        {
          "command": "agency.finding.reject.wrong-diagnosis",
          "when": "false"
        },
        {
          "command": "agency.finding.reject.duplicate-missed",
          "when": "false"
        },
        {
          "command": "agency.finding.reject.out-of-scope",
          "when": "false"
        },
        {
          "command": "agency.finding.openAtCommit",
          "when": "false"
        },
        {
          "command": "agency.finding.diffAgainstHead",
          "when": "false"
        },
        {
          "command": "agency.spike.reveal",
          "when": "false"
        },
        {
          "command": "agency.decision.apply",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "agency.finding.accept",
          "group": "inline@1",
          "when": "commentController == agency.findings"
        },
        {
          "command": "agency.finding.defer",
          "group": "inline@2",
          "when": "commentController == agency.findings"
        },
        {
          "submenu": "agency.rejectMenu",
          "group": "inline@3",
          "when": "commentController == agency.findings"
        },
        {
          "command": "agency.finding.openAtCommit",
          "group": "inline@4",
          "when": "commentController == agency.findings"
        },
        {
          "command": "agency.finding.diffAgainstHead",
          "group": "inline@5",
          "when": "commentController == agency.findings && commentThread == agencyFinding.drifted"
        }
      ],
      "agency.rejectMenu": [
        {
          "command": "agency.finding.reject.not-reproducible",
          "group": "1_reasons@1"
        },
        {
          "command": "agency.finding.reject.by-design",
          "group": "1_reasons@2"
        },
        {
          "command": "agency.finding.reject.wrong-diagnosis",
          "group": "1_reasons@3"
        },
        {
          "command": "agency.finding.reject.duplicate-missed",
          "group": "1_reasons@4"
        },
        {
          "command": "agency.finding.reject.out-of-scope",
          "group": "1_reasons@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "agency.finding.addNote",
          "group": "inline@1",
          "when": "commentController == agency.findings"
        }
      ],
      "comments/comment/context": [
        {
          "command": "agency.finding.rejectPick",
          "group": "inline@1",
          "when": "commentController == agency.findings"
        }
      ],
      "view/title": [
        {
          "command": "agency.review.pick",
          "group": "navigation@0",
          "when": "view == agency.findings.view"
        },
        {
          "command": "agency.spike.run",
          "group": "navigation@1",
          "when": "view == agency.findings.view"
        },
        {
          "command": "agency.spike.showThreads",
          "group": "navigation@2",
          "when": "view == agency.findings.view"
        }
      ]
    }
  }
}
