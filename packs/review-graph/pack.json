{
  "name": "review-graph",
  "title": "Reviewer",
  "description": "Walks a pull request — open or merged — cross-checks the changes against the real structure of the code from code-review-graph (blast radius, missing tests, dead code) and backs every finding with evidence.",
  "requires": ["git", "gh", "code-review-graph"],
  "target": "pull-request",
  "worktree": true,
  "graph": { "required": ["changes", "impact"], "optional": [] },
  "prompt": "optional",
  "needs": [
    "agency triage", "agency note", "agency findings",
    "code-review-graph", "git",
    "gh pr view", "gh pr diff", "gh pr comment", "gh issue view",
    "npx vitest", "npm test"
  ],
  "minScore": 80,
  "dimensions": [
    { "id": "correctness", "title": "Correctness and blast radius" },
    { "id": "tests", "title": "Test coverage" },
    { "id": "reuse", "title": "Reuse and dead code" },
    { "id": "errors", "title": "Error handling" },
    { "id": "repo-rules", "title": "Adherence to project rules" }
  ]
}
